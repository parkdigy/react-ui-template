{
  "name": "react-ui-template",
  "browserslist": [
    "extends browserslist-config-baseline"
  ],
  "scripts": {
    "dev": "concurrently --kill-others \"npm run dev:rspack\" \"npm run dev:lint\" \"npm run tsc -- --watch --preserveWatchOutput\"",
    "dev-no-update": "npm run dev",
    "clean:prod": "rm -rf build && rm -rf dist && mkdir dist",
    "clean:prod:win": "rmdir /s /q build && rmdir /s /q dist && mkdir dist",
    "build": "npm run clean:prod && npm run lint && npm run tsc && npm run build:rspack",
    "build:win": "npm run clean:prod:win && npm run lint && npm run tsc && npm run build:rspack",
    "git:commit": "cd .. && npm run git:commit",
    "git:push": "cd .. && npm run git:push",
    "git:commit:push": "cd .. && npm run git:commit:push",
    "git:merge:mirror": "cd .. && npm run git:merge:mirror",
    "reinstall": "npm run reinstall:module",
    "reinstall:module": "rm -rf node_modules && rm -f package-lock.json && npm i",
    "check:update": "npx npm-check-updates",
    "lint": "eslint src",
    "tsc": "npx tsc --noEmit",
    "publish:development": "cd .. && npm run publish:development",
    "publish:staging": "cd .. && npm run publish:staging",
    "publish:production": "cd .. && npm run publish:production",
    "pub:dev": "cd .. && npm run pub:dev",
    "pub:staging": "cd .. && npm run pub:staging",
    "pub:prod": "cd .. && npm run pub:prod",
    "pub:all": "cd .. && npm run pub:all",
    "build:rspack": "cross-env NODE_ENV=production rspack build --config rspack.config.js",
    "dev:rspack": "cross-env NODE_ENV=development rspack serve --config rspack.config.js",
    "dev:lint": "nodemon --watch src --ext ts,tsx --exec \"eslint src --cache\""
  },
  "devDependencies": {
    "@eslint/js": "^9.28.0",
    "@loadable/component": "^5.16.7",
    "@pdg/api": "^1.0.27",
    "@pdg/compare": "^1.0.9",
    "@pdg/data": "^1.0.9",
    "@pdg/date-time": "^1.0.6",
    "@pdg/eslint-plugin-react-hook": "^1.0.4",
    "@pdg/formatting": "^1.0.9",
    "@pdg/korean": "^1.0.4",
    "@pdg/react-hook": "^2.0.24",
    "@pdg/types": "^1.0.11",
    "@rspack/cli": "2.2.9",
    "@rspack/core": "2.2.9",
    "@rspack/dev-server": "2.2.2",
    "@rspack/plugin-react-refresh": "2.0.2",
    "@svgr/webpack": "^8.1.0",
    "@types/jest": "^30.0.0",
    "@types/loadable__component": "^5.13.10",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@types/react-modal": "^3.16.3",
    "@types/react-syntax-highlighter": "^15.5.13",
    "@typescript-eslint/parser": "^8.70.0",
    "axios": "^1.20.0",
    "baseline-browser-mapping": "^2.11.21",
    "browserslist-config-baseline": "^0.5.0",
    "classnames": "^2.5.1",
    "color": "^5.0.3",
    "concurrently": "^10.0.5",
    "copy-to-clipboard": "^4.0.2",
    "core-js": "^3.50.0",
    "cross-env": "^10.1.0",
    "css-loader": "^7.1.5",
    "dayjs": "^1.11.23",
    "dotenv": "^17.4.2",
    "eslint": "9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-prettier": "^5.5.7",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "file-loader": "^6.2.0",
    "html-loader": "^5.1.0",
    "ignore-loader": "^0.1.2",
    "js-file-download": "^0.4.12",
    "material-icons": "^1.13.14",
    "nodemon": "^3.1.14",
    "patch-package": "^8.0.1",
    "path": "^0.12.7",
    "postinstall-postinstall": "^2.1.0",
    "prettier": "^3.9.6",
    "react": "^19.2.8",
    "react-colorful": "^5.8.1",
    "react-dom": "^19.2.8",
    "react-error-boundary": "^6.1.5",
    "react-modal": "^3.16.3",
    "react-refresh": "^0.18.0",
    "react-resize-detector": "^12.3.0",
    "react-router": "^7.18.3",
    "react-svg": "^16.3.0",
    "react-syntax-highlighter": "^16.1.1",
    "react-toastify": "^11.1.0",
    "react-tooltip": "^5.29.1",
    "react-use-error-boundary": "^3.0.0",
    "sass": "^1.104.0",
    "sass-loader": "^17.0.1",
    "simplebar-react": "^3.3.2",
    "source-map-loader": "^5.0.0",
    "style-loader": "^4.0.0",
    "styled-components": "^6.5.3",
    "typescript": "5.9.3",
    "typescript-eslint": "^8.70.0",
    "url-loader": "^4.1.1",
    "usehooks-ts": "^3.1.1",
    "webpack-bundle-analyzer": "^5.4.0"
  },
  "allowScripts": {
    "@parcel/watcher": true,
    "core-js": true,
    "fsevents": true,
    "postinstall-postinstall": true
  }
}
